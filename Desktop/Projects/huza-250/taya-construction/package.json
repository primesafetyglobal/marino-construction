{
  "name": "marino-construction",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma generate --config prisma7.config.ts && prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:status": "prisma migrate status --config prisma7.config.ts",
    "db:seed": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.scripts.json prisma/seed.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.scripts.json prisma/seed.ts --demo",
    "auth:cleanup": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.scripts.json scripts/cleanup-auth.ts",
    "auth:reset-super-admin": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.scripts.json scripts/reset-super-admin.ts",
    "filing:bootstrap": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.scripts.json scripts/filing-bootstrap.ts",
    "filing:rotate-key": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.scripts.json scripts/filing-rotate-key.ts",
    "dnsa:check": "bash scripts/dnsa-check.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/lib-storage": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "archiver": "7.0.1",
    "bcryptjs": "3.0.3",
    "lru-cache": "11.5.3",
    "lucide-react": "1.57.0",
    "mime-types": "3.0.2",
    "next": "16.3.6",
    "next-auth": "4.24.15",
    "p-limit": "7.3.3",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/archiver": "6.0.4",
    "@types/mime-types": "3.0.1",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "18.0.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
